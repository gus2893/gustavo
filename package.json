{
  "name": "gustavo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.7.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "invitation:issue": "tsx scripts/issue-invitation.ts",
    "cache:rebuild": "tsx scripts/rebuild-projections.ts rebuild",
    "cache:prewarm": "tsx scripts/rebuild-projections.ts prewarm",
    "worker:stream": "tsx worker/stream/publish-events.ts",
    "worker:runtime": "tsx worker/runtime.ts",
    "mvp:start": "docker compose --env-file infra/.env -f infra/compose.yaml run --rm migrate && docker compose --env-file infra/.env -f infra/compose.yaml up --build --remove-orphans",
    "start": "pnpm cache:prewarm && next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@upstash/qstash": "^2.11.3",
    "@vercel/functions": "^3.9.3",
    "decimal.js": "10.6.0",
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
