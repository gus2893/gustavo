# Copy this file to infra/.env. Keep infra/.env private and supply fresh values.
POSTGRES_DB=gustavo
POSTGRES_USER=gustavo
POSTGRES_PASSWORD=
DATABASE_URL=
# Local hybrid worker only. Never set this in Vercel or forward it to Codex,
# Finnhub, QStash, Tailscale, a browser, or any public response.
GUSTAVO_MARKET_MATERIALIZER_DATABASE_URL=
GUSTAVO_PORT=3000
GUSTAVO_EVENT_ROOT_KEY_V1=
GUSTAVO_CURSOR_SIGNING_KEY=
GUSTAVO_CACHE_ENCRYPTION_KEY=
GUSTAVO_COUNCIL_PSEUDONYM_KEY=
GUSTAVO_EVALUATOR_PSEUDONYM_KEY=
GUSTAVO_OPERATOR_HEALTH_TOKEN=

# Local hybrid-worker values remain blank in source control. Setup records the
# immutable image ID and canonical trusted executables in its owner-only config.
GUSTAVO_HYBRID_IMAGE_DIGEST=
GUSTAVO_DOCKER_EXECUTABLE=
GUSTAVO_NODE_EXECUTABLE=
GUSTAVO_COREPACK_EXECUTABLE=
GUSTAVO_TAILSCALE_EXECUTABLE=
GUSTAVO_HYBRID_PORT=
GUSTAVO_HYBRID_PUBLIC_WAKE_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
FINNHUB_API_KEY=

# Optional role metadata for the provider-neutral gateway. T30 has no production
# model or market-data network adapter, so these can remain blank for local boot.
GUSTAVO_MODEL_MAIN_PROVIDER=
GUSTAVO_MODEL_MAIN_MODEL=
GUSTAVO_MODEL_MAIN_MONTHLY_BUDGET_USD=
GUSTAVO_MODEL_NODE_PROVIDER=
GUSTAVO_MODEL_NODE_MODEL=
GUSTAVO_MODEL_NODE_MONTHLY_BUDGET_USD=
GUSTAVO_MODEL_EVALUATOR_PROVIDER=
GUSTAVO_MODEL_EVALUATOR_MODEL=
GUSTAVO_MODEL_EVALUATOR_MONTHLY_BUDGET_USD=
